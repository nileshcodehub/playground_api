{
  "name": "Playground API — Stateful Mock REST API",
  "short_name": "PlaygroundAPI",
  "description": "Free JSONPlaceholder alternative with per-identity sandbox overlays for real HTTP prototyping.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#6366f1",
  "icons": [
    {
      "src": "/public/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/public/favicon.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/public/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
