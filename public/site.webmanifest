{
  "name": "Playground API — Stateful Mock REST & GraphQL Service",
  "short_name": "PlaygroundAPI",
  "description": "Free JSONPlaceholder alternative with per-identity sandbox overlays for real HTTP prototyping.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#10b981",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon",
      "sizes": "48x48",
      "type": "image/png"
    },
    {
      "src": "/apple-icon",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
