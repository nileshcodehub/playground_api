<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body>
    <div class="app-layout">
      <!-- Left Sidebar (Desktop 2-Column) -->
      <aside class="sidebar">
        <a href="/" class="brand">
          <img src="/public/favicon.svg" alt="Playground API Logo" class="brand-icon" style="width: 32px; height: 32px; border-radius: 8px;" />
          <div>
            <div class="brand-title">Playground API</div>
          </div>
          <span class="brand-version">v1.0</span>
        </a>

        <!-- Theme Switcher Controller -->
        <div class="theme-controller">
          <span class="theme-label">Theme</span>
          <div class="theme-toggle-group">
            <button type="button" class="theme-btn" data-theme-val="dark" title="Dark Obsidian">🌙 Dark</button>
            <button type="button" class="theme-btn" data-theme-val="light" title="Light Mode">☀️ Light</button>
          </div>
        </div>

        <!-- Live Search Box -->
        <div class="sidebar-search-box">
          <input
            type="search"
            id="sidebar-search"
            placeholder="🔍 Search endpoints..."
            class="sidebar-search"
          />
        </div>

        <!-- Identity Session Status Card -->
        <div class="session-card">
          <div class="session-card-header">
            <span>Identity Session</span>
            <span class="status-dot" title="Session Active"></span>
          </div>
          <div class="session-id">
            <%= (typeof identityId !== 'undefined' && identityId) ? (identityId.slice(0, 8) + '...') :
            'Cookie Active (pg_identity)' %>
          </div>
          <div class="session-note">
            Mutations are session-isolated via HTTP cookie. Global datasets
            remain pristine.
          </div>
          <button type="button" id="reset-sandbox-btn" class="reset-sandbox-btn" title="Purge all sandbox mutations for this session">
            🔄 Reset Sandbox
          </button>
        </div>

        <!-- Navigation Menu -->
        <nav class="nav-section">
          <div class="nav-section-title">Documentation</div>
          <a
            href="/"
            class="nav-item <%= (typeof currentNav !== 'undefined' && currentNav === 'overview') ? 'active' : '' %>"
          >
            <span>Overview</span>
          </a>

          <div class="nav-section-title" style="margin-top: 1rem">
            API Resources
          </div>
          <a
            href="/docs/users"
            class="nav-item <%= (typeof currentNav !== 'undefined' && currentNav === 'users') ? 'active' : '' %>"
          >
            <span>users</span>
            <span class="nav-count">REST</span>
          </a>
          <a
            href="/docs/posts"
            class="nav-item <%= (typeof currentNav !== 'undefined' && currentNav === 'posts') ? 'active' : '' %>"
          >
            <span>posts</span>
            <span class="nav-count">REST</span>
          </a>
          <a
            href="/docs/comments"
            class="nav-item <%= (typeof currentNav !== 'undefined' && currentNav === 'comments') ? 'active' : '' %>"
          >
            <span>comments</span>
            <span class="nav-count">REST</span>
          </a>
          <a
            href="/docs/todos"
            class="nav-item <%= (typeof currentNav !== 'undefined' && currentNav === 'todos') ? 'active' : '' %>"
          >
            <span>todos</span>
            <span class="nav-count">REST</span>
          </a>
        </nav>
      </aside>

      <!-- Right Main Area -->
      <main class="main-area">
        <%- body %>

        <footer class="footer">
          <p>Playground API — Built with 💖 by Nilesh Kumar</p>
        </footer>
      </main>
    </div>

    <script src="/public/js/endpoints-catalog.js"></script>
    <script src="/public/js/try-it.js"></script>
  </body>
</html>
