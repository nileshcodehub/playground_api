<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body>
    <div class="app-layout">
      <!-- Left Sidebar (Desktop 2-Column) -->
      <aside class="sidebar">
        <a href="/" class="brand">
          <img src="/public/favicon.svg" alt="Playground API Logo" class="brand-icon" style="width: 32px; height: 32px; border-radius: 8px;" />
          <div>
            <div class="brand-title">Playground API</div>
          </div>
          <span class="brand-version">v1.0</span>
        </a>

        <!-- Theme Switcher Controller -->
        <div class="theme-controller">
          <span class="theme-label">Theme</span>
          <div class="theme-toggle-group">
            <button type="button" class="theme-btn" data-theme-val="dark" title="Dark Obsidian">🌙 Dark</button>
            <button type="button" class="theme-btn" data-theme-val="light" title="Light Mode">☀️ Light</button>
          </div>
        </div>

        <!-- Live Search Box -->
        <div class="sidebar-search-box">
          <input
            type="search"
            id="sidebar-search"
            placeholder="🔍 Search endpoints..."
            class="sidebar-search"
          />
        </div>

        <!-- Identity Session Status Card -->
        <div class="session-card">
          <div class="session-card-header">
            <span>Identity Session</span>
            <span class="status-dot" title="Session Active"></span>
          </div>
          <div class="session-id" id="session-id-display" data-session-token="<%= (typeof signedToken !== 'undefined' && signedToken) ? signedToken : (typeof identityId !== 'undefined' ? identityId : '') %>">
            <%= (typeof identityId !== 'undefined' && identityId) ? (identityId.slice(0, 8) + '...') : 'Active Session' %>
          </div>
          <div class="session-actions">
            <button type="button" id="copy-session-id-btn" class="session-action-btn copy-session-btn" title="Copy signed Session Token for X-Playground-Identity header">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Copy</span>
            </button>
            <button type="button" id="reset-sandbox-btn" class="session-action-btn reset-sandbox-btn" title="Purge all sandbox mutations for this session">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
              <span>Reset</span>
            </button>
          </div>
          <div class="session-note">
            Mutations are session-isolated & HMAC signed. Global datasets remain pristine.
          </div>
        </div>

        <!-- Navigation Menu -->
        <nav class="nav-section">
          <div class="nav-section-title">Documentation</div>
          <a
            href="/"
            class="nav-item <%= (typeof currentNav !== 'undefined' && currentNav === 'overview') ? 'active' : '' %>"
          >
            <span>Overview</span>
          </a>

          <div class="nav-section-title" style="margin-top: 1rem">
            API Resources
          </div>
          <a
            href="/docs/users"
            class="nav-item <%= (typeof currentNav !== 'undefined' && currentNav === 'users') ? 'active' : '' %>"
          >
            <span>users</span>
            <span class="nav-count">REST</span>
          </a>
          <a
            href="/docs/posts"
            class="nav-item <%= (typeof currentNav !== 'undefined' && currentNav === 'posts') ? 'active' : '' %>"
          >
            <span>posts</span>
            <span class="nav-count">REST</span>
          </a>
          <a
            href="/docs/comments"
            class="nav-item <%= (typeof currentNav !== 'undefined' && currentNav === 'comments') ? 'active' : '' %>"
          >
            <span>comments</span>
            <span class="nav-count">REST</span>
          </a>
          <a
            href="/docs/todos"
            class="nav-item <%= (typeof currentNav !== 'undefined' && currentNav === 'todos') ? 'active' : '' %>"
          >
            <span>todos</span>
            <span class="nav-count">REST</span>
          </a>
        </nav>
      </aside>

      <!-- Right Main Area -->
      <main class="main-area">
        <%- body %>

        <footer class="footer">
          <p>Playground API — Built with 💖 by Nilesh Kumar</p>
        </footer>
      </main>
    </div>

    <script src="/public/js/endpoints-catalog.js"></script>
    <script src="/public/js/try-it.js"></script>
  </body>
</html>
