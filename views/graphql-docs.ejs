    </table>
  </div>
</div>

<!-- Endpoint Block 1: GraphQL Query Endpoint -->
<%- include('partials/endpoint', { 
  method: 'POST', 
  path: '/graphql', 
  summary: 'Execute GraphQL Queries & Mutations against Session Sandbox', 
  params: [
    { name: 'query', type: 'String (Required)', desc: 'The GraphQL query or mutation string to execute.' },
    { name: 'variables', type: 'Object (Optional)', desc: 'JSON object containing GraphQL variable definitions.' },
    { name: 'operationName', type: 'String (Optional)', desc: 'Specific operation name if query contains multiple operations.' }
  ], 
  bodyExample: JSON.stringify({
    query: `query GetUsersWithPosts($limit: Int) {\n  users(limit: $limit) {\n    id\n    name\n    email\n    posts {\n      id\n      title\n    }\n  }\n}`,
    variables: { limit: 3 }
  }, null, 2), 
  responseExample: JSON.stringify({
    data: {
      users: [
        {
          id: "1",
          name: "Leanne Graham",
          email: "Sincere@april.biz",
          posts: [
            { id: "1", title: "sunt aut facere repellat provident occaecati excepturi optio reprehenderit" },
            { id: "2", title: "qui est esse" }
          ]
        }
      ]
    }
  }, null, 2)
}) %>

<!-- Endpoint Block 2: Mutation Example -->
<%- include('partials/endpoint', { 
  method: 'POST', 
  path: '/graphql', 
  summary: 'Create Sandboxed Post via GraphQL Mutation', 
  params: [
    { name: 'query', type: 'String (Required)', desc: 'GraphQL mutation query.' },
    { name: 'variables', type: 'Object (Optional)', desc: 'Input parameters for mutation.' }
  ], 
  bodyExample: JSON.stringify({
    query: `mutation CreatePost($userId: ID!, $title: String!, $body: String) {\n  createPost(user_id: $userId, title: $title, body: $body) {\n    id\n    user_id\n    title\n    body\n  }\n}`,
    variables: { userId: "1", title: "New GraphQL Post", body: "Created via GraphQL Gateway!" }
  }, null, 2), 
  responseExample: JSON.stringify({
    data: {
      createPost: {
        id: "local-a1b2c3d4-5678-90ef",
        user_id: "1",
        title: "New GraphQL Post",
        body: "Created via GraphQL Gateway!"
      }
    }
  }, null, 2)
}) %>
