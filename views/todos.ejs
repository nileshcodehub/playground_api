<div class="hero">
  <h1 class="hero-title">Todos Resource Documentation</h1>
  <p class="hero-subtitle">
    Read operations merge shared global todos with your session's overlay (newly created todos appear at the top, updates apply in-place, deletes are filtered).
    Each todo belongs to a user (`user_id` foreign key). Mutations are session-scoped and capped at 30 created records.
  </p>
</div>

<!-- Per-Resource Collection Export Banner -->
<div class="endpoint-card resource-export-banner">
  <span style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary);">
    📥 Export Todos Collection:
  </span>
  <div class="resource-export-group">
    <a href="/downloads/openapi.json?resource=todos" download class="session-action-btn" style="text-decoration: none;" title="Download Todos OpenAPI 3.0 Spec">🌐 OpenAPI</a>
    <a href="/downloads/postman.json?resource=todos" download class="session-action-btn" style="text-decoration: none;" title="Download Todos Postman Collection">📦 Postman</a>
    <a href="/downloads/bruno.json?resource=todos" download class="session-action-btn" style="text-decoration: none;" title="Download Todos Bruno Collection">🐶 Bruno</a>
    <a href="/downloads/insomnia.json?resource=todos" download class="session-action-btn" style="text-decoration: none;" title="Download Todos Insomnia Collection">💧 Insomnia</a>
  </div>
</div>

<% if (typeof endpoints !== 'undefined' && endpoints && endpoints.length > 0) { %>
  <% endpoints.forEach(ep => { %>
    <%- include('partials/endpoint', { 
      method: ep.method, 
      path: ep.path, 
      summary: ep.summary, 
      params: ep.params, 
      bodyExample: ep.bodyExample, 
      responseExample: ep.responseExample 
    }) %>
  <% }); %>
<% } %>
