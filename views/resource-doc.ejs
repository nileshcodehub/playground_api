<% 
  const formattedName = resource.charAt(0).toUpperCase() + resource.slice(1);
%>

<div class="hero">
  <h1 class="hero-title"><%= formattedName %> Resource Documentation</h1>
  <p class="hero-subtitle">
    <%= typeof resourceSubtitle !== 'undefined' && resourceSubtitle ? resourceSubtitle : `Read operations merge shared global ${resource} with your session's overlay (creates appear at top, updates apply in-place, deletes are filtered). All mutations are session-scoped and capped at 30 created records.` %>
  </p>
</div>

<!-- Per-Resource Collection Export Banner -->
<div class="endpoint-card resource-export-banner">
  <span style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary);">
    📥 Export <%= formattedName %> Collection:
  </span>
  <div class="resource-export-group">
    <a href="/downloads/openapi.json?resource=<%= resource %>" download class="session-action-btn" style="text-decoration: none;" title="Download <%= formattedName %> OpenAPI 3.0 Spec">🌐 OpenAPI</a>
    <a href="/downloads/postman.json?resource=<%= resource %>" download class="session-action-btn" style="text-decoration: none;" title="Download <%= formattedName %> Postman Collection">📦 Postman</a>
    <a href="/downloads/bruno.json?resource=<%= resource %>" download class="session-action-btn" style="text-decoration: none;" title="Download <%= formattedName %> Bruno Collection">🐶 Bruno</a>
    <a href="/downloads/insomnia.json?resource=<%= resource %>" download class="session-action-btn" style="text-decoration: none;" title="Download <%= formattedName %> Insomnia Collection">💧 Insomnia</a>
  </div>
</div>

<% if (typeof endpoints !== 'undefined' && endpoints && endpoints.length > 0) { %>
  <% endpoints.forEach(ep => { %>
    <%- include('partials/endpoint', { 
      method: ep.method, 
      path: ep.path, 
      summary: ep.summary, 
      params: ep.params, 
      bodyExample: ep.bodyExample, 
      responseExample: ep.responseExample 
    }) %>
  <% }); %>
<% } %>
