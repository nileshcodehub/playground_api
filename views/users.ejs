<div class="hero">
  <h1 class="hero-title">Users Resource Documentation</h1>
  <p class="hero-subtitle">
    Read operations merge shared global users data with your session's overlay (creates appear at the top, deletes are removed, updates preserve position).
    All mutations are session-scoped via an HTTP cookie and never affect shared global data or other visitors.
  </p>
</div>

<% if (typeof endpoints !== 'undefined' && endpoints && endpoints.length > 0) { %>
  <% endpoints.forEach(ep => { %>
    <%- include('partials/endpoint', { 
      method: ep.method, 
      path: ep.path, 
      summary: ep.summary, 
      params: ep.params, 
      bodyExample: ep.bodyExample, 
      responseExample: ep.responseExample 
    }) %>
  <% }); %>
<% } %>
