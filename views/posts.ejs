<div class="hero">
  <h1 class="hero-title">Posts Resource Documentation</h1>
  <p class="hero-subtitle">
    Read operations merge shared global posts with your session's overlay (newly created posts appear at the top, updates apply in-place, deletes are filtered).
    Each post belongs to a user (`user_id` foreign key). Mutations are session-scoped and capped at 30 created records.
  </p>
</div>

<% 
  const fallbackPost = {
    id: 1,
    user_id: 1,
    title: "Post 1 by User 1",
    body: "This is the body content of sample post #1 written by user #1 on Playground API."
  };

  const realPost = (typeof sampleRecord !== 'undefined' && sampleRecord) ? sampleRecord : fallbackPost;
  const samplePostResponse = JSON.stringify(realPost, null, 2);

  const samplePostPayload = JSON.stringify({
    user_id: realPost.user_id || 1,
    title: realPost.title || "My New Post Title",
    body: realPost.body || "Detailed content body for the new post created in sandbox."
  }, null, 2);

  const sampleCreatedPostResponse = JSON.stringify({
    id: "local-b2c3d4e5-f6a7-8901-bcde-f12345678901",
    user_id: realPost.user_id || 1,
    title: realPost.title || "My New Post Title",
    body: realPost.body || "Detailed content body for the new post created in sandbox.",
    _sandbox: "created"
  }, null, 2);

  const samplePatchPayload = JSON.stringify({
    title: `${realPost.title} (Updated)`
  }, null, 2);

  const sampleUpdatedPostResponse = JSON.stringify({
    ...realPost,
    title: `${realPost.title} (Updated)`,
    _sandbox: "updated"
  }, null, 2);

  const samplePaginatedResponse = JSON.stringify({
    data: [
      JSON.parse(sampleCreatedPostResponse),
      realPost
    ],
    pagination: {
      page: 1,
      limit: 10,
      total: 101,
      totalPages: 11,
      hasNextPage: true,
      hasPrevPage: false
    }
  }, null, 2);

  const endpoints = [
    {
      method: "GET",
      path: "/posts",
      summary: "Retrieve a paginated list of posts. Results merge shared global post records with session sandbox overlays (newly created posts appear at the top).",
      params: [
        { name: "page", in: "query", type: "integer", description: "Page number (1-indexed, default 1)." },
        { name: "limit", in: "query", type: "integer", description: "Number of records per page (default 10, max 30)." }
      ],
      bodyExample: null,
      responseExample: samplePaginatedResponse
    },
    {
      method: "GET",
      path: "/posts/:id",
      summary: `Retrieve a single post by ID. Supports plain integer IDs for global records (e.g. ${realPost.id}) and string IDs formatted as local-<uuid> for session sandbox records.`,
      params: [
        { name: "id", in: "path", type: "string | integer", description: `Post ID (e.g. ${realPost.id} for global post or local-<uuid> for sandbox post).` }
      ],
      bodyExample: null,
      responseExample: samplePostResponse
    },
    {
      method: "POST",
      path: "/posts",
      summary: "Create a new session sandbox post record. Returns a local-<uuid> formatted ID with _sandbox: 'created'. Each session identity is capped at 30 created records.",
      params: [
        { name: "user_id", in: "body", type: "integer", description: "Author user ID." },
        { name: "title", in: "body", type: "string", description: "Post title." },
        { name: "body", in: "body", type: "string", description: "Post content body." }
      ],
      bodyExample: samplePostPayload,
      responseExample: sampleCreatedPostResponse
    },
    {
      method: "PUT",
      path: "/posts/:id",
      summary: "Replace an existing post record in the session overlay. Global records remain untouched for other visitors and preserve original list position.",
      params: [
        { name: "id", in: "path", type: "string | integer", description: `Post ID to update (e.g. ${realPost.id} or local-<uuid>).` }
      ],
      bodyExample: samplePostPayload,
      responseExample: sampleUpdatedPostResponse
    },
    {
      method: "PATCH",
      path: "/posts/:id",
      summary: "Partially update specific fields of a post record in the session overlay.",
      params: [
        { name: "id", in: "path", type: "string | integer", description: `Post ID to patch (e.g. ${realPost.id} or local-<uuid>).` }
      ],
      bodyExample: samplePatchPayload,
      responseExample: sampleUpdatedPostResponse
    },
    {
      method: "DELETE",
      path: "/posts/:id",
      summary: "Remove a post record from the requesting session view. The underlying global record is unaffected for other visitors.",
      params: [
        { name: "id", in: "path", type: "string | integer", description: `Post ID to delete (e.g. ${realPost.id} or local-<uuid>).` }
      ],
      bodyExample: null,
      responseExample: "204 No Content"
    }
  ];
%>

<% endpoints.forEach(ep => { %>
  <%- include('partials/endpoint', { 
    method: ep.method, 
    path: ep.path, 
    summary: ep.summary, 
    params: ep.params, 
    bodyExample: ep.bodyExample, 
    responseExample: ep.responseExample 
  }) %>
<% }); %>
