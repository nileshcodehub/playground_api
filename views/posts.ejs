<div class="hero">
  <h1 class="hero-title">Posts Resource Documentation</h1>
  <p class="hero-subtitle">
    Read operations merge shared global posts with your session's overlay (newly created posts appear at the top, updates apply in-place, deletes are filtered).
    Each post belongs to a user (`user_id` foreign key). Mutations are session-scoped and capped at 30 created records.
  </p>
</div>

<!-- Per-Resource Collection Export Banner -->
<div class="endpoint-card" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem; padding: 0.85rem 1.25rem;">
  <span style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary);">
    📥 Export Posts Collection:
  </span>
  <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
    <a href="/downloads/openapi.json?resource=posts" download class="session-action-btn" style="text-decoration: none;" title="Download Posts OpenAPI 3.0 Spec">🌐 OpenAPI</a>
    <a href="/downloads/postman.json?resource=posts" download class="session-action-btn" style="text-decoration: none;" title="Download Posts Postman Collection">📦 Postman</a>
    <a href="/downloads/bruno.json?resource=posts" download class="session-action-btn" style="text-decoration: none;" title="Download Posts Bruno Collection">🐶 Bruno</a>
    <a href="/downloads/insomnia.json?resource=posts" download class="session-action-btn" style="text-decoration: none;" title="Download Posts Insomnia Collection">💧 Insomnia</a>
  </div>
</div>

<% if (typeof endpoints !== 'undefined' && endpoints && endpoints.length > 0) { %>
  <% endpoints.forEach(ep => { %>
    <%- include('partials/endpoint', { 
      method: ep.method, 
      path: ep.path, 
      summary: ep.summary, 
      params: ep.params, 
      bodyExample: ep.bodyExample, 
      responseExample: ep.responseExample 
    }) %>
  <% }); %>
<% } %>
