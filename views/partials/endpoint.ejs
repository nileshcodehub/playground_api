<%
  const sampleBodyStr = (typeof bodyExample !== 'undefined' && bodyExample) ? bodyExample.replace(/\n\s*/g, ' ') : '';
  const formattedBodyForCurl = (typeof bodyExample !== 'undefined' && bodyExample) ? bodyExample : '{}';

  const curlCmd = method === 'GET' 
    ? `curl -X GET 'http://localhost:3000${path}' \\\n  -H 'Content-Type: application/json' \\\n  -b "pg_identity=your_cookie_uuid"`
    : method === 'DELETE'
    ? `curl -X DELETE 'http://localhost:3000${path}' \\\n  -H 'Content-Type: application/json' \\\n  -b "pg_identity=your_cookie_uuid"`
    : `curl -X ${method} 'http://localhost:3000${path}' \\\n  -H 'Content-Type: application/json' \\\n  -b "pg_identity=your_cookie_uuid" \\\n  -d '${formattedBodyForCurl}'`;

  const fetchCmd = method === 'GET' || method === 'DELETE'
    ? `fetch('http://localhost:3000${path}', {\n  method: '${method}',\n  credentials: 'include'\n})\n  .then(res => res.json())\n  .then(data => console.log(data));`
    : `fetch('http://localhost:3000${path}', {\n  method: '${method}',\n  headers: { 'Content-Type': 'application/json' },\n  credentials: 'include',\n  body: JSON.stringify(${sampleBodyStr || '{}'})\n})\n  .then(res => res.json())\n  .then(data => console.log(data));`;

  const axiosCmd = method === 'GET'
    ? `import axios from 'axios';\n\naxios.get('http://localhost:3000${path}', {\n  withCredentials: true\n}).then(response => console.log(response.data));`
    : method === 'DELETE'
    ? `import axios from 'axios';\n\naxios.delete('http://localhost:3000${path}', {\n  withCredentials: true\n}).then(response => console.log(response.data));`
    : `import axios from 'axios';\n\naxios.${method.toLowerCase()}('http://localhost:3000${path}', ${sampleBodyStr || '{}'}, {\n  withCredentials: true\n}).then(response => console.log(response.data));`;

  const pythonCmd = method === 'GET'
    ? `import requests\n\nresponse = requests.get('http://localhost:3000${path}')\nprint(response.json())`
    : method === 'DELETE'
    ? `import requests\n\nresponse = requests.delete('http://localhost:3000${path}')\nprint(response.status_code)`
    : `import requests\n\npayload = ${sampleBodyStr || '{}'}\nresponse = requests.${method.toLowerCase()}('http://localhost:3000${path}', json=payload)\nprint(response.json())`;
%>

<div class="endpoint-card" data-endpoint-text="<%= method %> <%= path %> <%= summary %>">
  <div class="endpoint-header">
    <div class="endpoint-header-left">
      <span class="badge badge-<%= method.toLowerCase() %>"><%= method %></span>
      <span class="endpoint-path"><%= path %></span>
    </div>
    <button type="button" class="copy-url-btn" data-url="http://localhost:3000<%= path %>">
      <span>🔗 Copy URL</span>
    </button>
  </div>

  <p class="endpoint-summary"><%= summary %></p>

  <% if (typeof params !== 'undefined' && params && params.length > 0) { %>
    <div class="params-container">
      <div class="params-title">Request Parameters</div>
      <table class="params-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Location</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          <% params.forEach(param => { %>
            <tr>
              <td><code><%= param.name %></code></td>
              <td><code><%= param.type %></code></td>
              <td><span class="param-in"><%= param.in %></span></td>
              <td><%= param.description %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>

  <!-- Code Generator Tabs (cURL, Node, Axios, Python) -->
  <div class="snippet-container">
    <div class="snippet-header">
      <div class="snippet-tabs">
        <button type="button" class="snippet-tab-btn active" data-target="curl">cURL</button>
        <button type="button" class="snippet-tab-btn" data-target="node">Node (fetch)</button>
        <button type="button" class="snippet-tab-btn" data-target="axios">Axios</button>
        <button type="button" class="snippet-tab-btn" data-target="python">Python</button>
      </div>
      <button type="button" class="copy-btn">
        <span>📋 Copy Code</span>
      </button>
    </div>
    <div class="snippet-content">
      <pre class="snippet-code-block" data-snippet="curl"><code><%= curlCmd %></code></pre>
      <pre class="snippet-code-block" data-snippet="node" hidden><code><%= fetchCmd %></code></pre>
      <pre class="snippet-code-block" data-snippet="axios" hidden><code><%= axiosCmd %></code></pre>
      <pre class="snippet-code-block" data-snippet="python" hidden><code><%= pythonCmd %></code></pre>
    </div>
  </div>

  <div class="examples-grid">
    <% if (typeof bodyExample !== 'undefined' && bodyExample) { %>
      <div class="example-box">
        <h4>Request Payload Example</h4>
        <pre><code><%= bodyExample %></code></pre>
      </div>
    <% } %>

    <% if (typeof responseExample !== 'undefined' && responseExample) { %>
      <div class="example-box">
        <h4>Response Schema Example</h4>
        <pre><code><%= responseExample %></code></pre>
      </div>
    <% } %>
  </div>

  <!-- Interactive Try It Tester -->
  <div class="try-it-container">
    <details class="try-it-details">
      <summary>
        <span>⚡ Try it out — Test endpoint live</span>
        <span style="font-size: 0.8rem; font-weight: normal; opacity: 0.8;">Run fetch</span>
      </summary>
      <div class="try-it-body">
        <form class="try-it__form" data-method="<%= method %>" data-path="<%= path %>">
          <% if (typeof params !== 'undefined' && params) { %>
            <% params.filter(p => p.in === 'path' || p.in === 'query').forEach(p => { %>
              <div class="form-group">
                <label for="param-<%= method %>-<%= path %>-<%= p.name %>">
                  <%= p.name %> (<%= p.in %>):
                </label>
                <input 
                  type="text" 
                  id="param-<%= method %>-<%= path %>-<%= p.name %>" 
                  data-param-name="<%= p.name %>" 
                  data-param-in="<%= p.in %>" 
                  placeholder="<%= p.description %>"
                  class="form-control"
                >
              </div>
            <% }); %>
          <% } %>

          <% if (typeof bodyExample !== 'undefined' && bodyExample) { %>
            <div class="form-group">
              <label for="body-<%= method %>-<%= path %>">JSON Request Body:</label>
              <textarea 
                id="body-<%= method %>-<%= path %>" 
                class="form-control body-input" 
                rows="5"
              ><%= bodyExample %></textarea>
            </div>
          <% } %>

          <div style="margin-top: 0.5rem;">
            <button type="submit" class="btn btn-primary">Execute Request</button>
          </div>
        </form>

        <pre class="try-it__result" hidden></pre>
      </div>
    </details>
  </div>
</div>
