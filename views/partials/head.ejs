<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Core Primary SEO Meta Tags -->
<title><%= typeof title !== 'undefined' ? title : 'Playground API — Free Stateful Fake REST API for Prototyping & Testing' %></title>
<meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Playground API is a free, stateful JSONPlaceholder alternative fake REST API. Zero configuration mock data with per-visitor sandbox overlays for GET, POST, PUT, and DELETE testing.' %>" />
<meta name="keywords" content="<%= typeof keywords !== 'undefined' ? keywords : 'free fake rest api, mock api, jsonplaceholder alternative, sandbox rest api, frontend testing, mock data api, stateful mock api' %>" />
<meta name="author" content="Nilesh Kumar" />
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#6366f1" />

<!-- Canonical URL -->
<link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'http://localhost:3000/' %>" />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/public/favicon.svg" />
<link rel="manifest" href="/public/site.webmanifest" />

<!-- Open Graph / Facebook Meta Tags -->
<meta property="og:type" content="website" />
<meta property="og:url" content="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'http://localhost:3000/' %>" />
<meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Playground API — Free Stateful Fake REST API' %>" />
<meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Free stateful fake REST API for prototyping and testing. Merges shared global datasets with per-identity sandbox overlays.' %>" />
<meta property="og:image" content="/public/favicon.svg" />
<meta property="og:site_name" content="Playground API" />

<!-- Twitter Card Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Playground API — Free Stateful Fake REST API' %>" />
<meta name="twitter:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Free stateful fake REST API for prototyping and testing with live interactive request runner.' %>" />
<meta name="twitter:image" content="/public/favicon.svg" />

<!-- Fonts and Styles -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/public/css/docs.css" />

<!-- JSON-LD Structured Data Schema Markup -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl.replace(/\/[^/]*$/, '/') : '/' %>#website",
      "url": "<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl.replace(/\/docs.*$/, '/') : '/' %>",
      "name": "Playground API",
      "description": "Free Stateful Fake REST API for Prototyping & Testing",
      "publisher": {
        "@type": "Person",
        "name": "Nilesh Kumar"
      }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl.replace(/\/docs.*$/, '/') : '/' %>#application",
      "name": "Playground API",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "A stateful JSONPlaceholder alternative mock API with per-visitor identity sandbox overlays."
    }
  ]
}
</script>

<script>
  (function() {
    var t = localStorage.getItem('playground_theme') || 'dark';
    document.documentElement.setAttribute('data-theme', t);
  })();
</script>
