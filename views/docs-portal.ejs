<script>
  // Simple Portal Tab Switching Script
  document.addEventListener('DOMContentLoaded', () => {
    const tabBtns = document.querySelectorAll('.portal-tab-btn');
    const tabContents = document.querySelectorAll('.portal-tab-content');

    function switchTab(targetTab) {
      tabBtns.forEach(btn => {
        if (btn.dataset.tab === targetTab) {
          btn.classList.add('active');
          btn.style.background = 'var(--bg-card)';
          btn.style.color = 'var(--primary-accent)';
          btn.style.borderColor = 'var(--border-color)';
        } else {
          btn.classList.remove('active');
          btn.style.background = 'transparent';
          btn.style.color = 'var(--text-secondary)';
          btn.style.borderColor = 'transparent';
        }
      });

      tabContents.forEach(content => {
        if (content.id === `portal-tab-${targetTab}`) {
          content.style.display = 'block';
        } else {
          content.style.display = 'none';
        }
      });
    }

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        switchTab(btn.dataset.tab);
      });
    });

    // Interactive API Studio Execution Handler
    const sendBtn = document.getElementById('studio-send-btn');
    const methodSelect = document.getElementById('studio-method-select');
    const urlInput = document.getElementById('studio-url-input');
    const delaySelect = document.getElementById('studio-delay-select');
    const statusSelect = document.getElementById('studio-status-select');
    const bodyInput = document.getElementById('studio-body-input');
    const bodyContainer = document.getElementById('studio-body-container');
    const resOutput = document.getElementById('studio-response-output');
    const statusBadge = document.getElementById('studio-res-status-badge');
    const timeBadge = document.getElementById('studio-res-time-badge');

    if (methodSelect && bodyContainer) {
      methodSelect.addEventListener('change', () => {
        const val = methodSelect.value;
        if (val === 'POST' || val === 'PUT' || val === 'PATCH') {
          bodyContainer.style.display = 'block';
          if (!bodyInput.value) {
            bodyInput.value = JSON.stringify({ title: 'Sample Title', body: 'Sample Content', userId: 1 }, null, 2);
          }
        } else {
          bodyContainer.style.display = 'none';
        }
      });
    }

    if (sendBtn) {
      sendBtn.addEventListener('click', async () => {
        const method = methodSelect.value;
        let url = urlInput.value.trim();
        if (!url.startsWith('http') && !url.startsWith('/')) {
          url = '/' + url;
        }

        const delay = delaySelect.value;
        const status = statusSelect.value;

        // Append query params if selected
        if (delay !== '0' && !url.includes('_delay=')) {
          url += (url.includes('?') ? '&' : '?') + `_delay=${delay}`;
        }
        if (status !== '200' && !url.includes('_status=')) {
          url += (url.includes('?') ? '&' : '?') + `_status=${status}`;
        }

        statusBadge.textContent = 'Status: Sending...';
        statusBadge.style.color = '#eab308';
        resOutput.innerHTML = '<code>Executing request...</code>';

        const startTime = Date.now();
        try {
          const fetchOpts = {
            method,
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include'
          };
          if ((method === 'POST' || method === 'PUT' || method === 'PATCH') && bodyInput.value) {
            fetchOpts.body = bodyInput.value;
          }

          const res = await fetch(url, fetchOpts);
          const duration = Date.now() - startTime;
          timeBadge.textContent = `${duration} ms`;

          statusBadge.textContent = `Status: ${res.status} ${res.statusText}`;
          if (res.ok) {
            statusBadge.style.color = '#22c55e';
          } else {
            statusBadge.style.color = '#ef4444';
          }

          const json = await res.json();
          resOutput.innerHTML = `<code>${JSON.stringify(json, null, 2)}</code>`;
        } catch (err) {
          const duration = Date.now() - startTime;
          timeBadge.textContent = `${duration} ms`;
          statusBadge.textContent = 'Status: Error';
          statusBadge.style.color = '#ef4444';
          resOutput.innerHTML = `<code>Error: ${err.message}</code>`;
        }
      });
    }
  });
</script>
