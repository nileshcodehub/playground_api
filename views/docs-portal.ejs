<div id="portal-tab-session" class="portal-tab-content" style="display: none; margin-top: 1.5rem;">
  <div class="endpoint-card">
    <h2 style="margin: 0 0 1rem 0; font-size: 1.3rem; color: var(--text-primary);">📊 Session Quota & Operational Health</h2>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
      <div style="background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem;">
        <div style="font-weight: 700; font-size: 0.95rem; color: var(--text-primary); margin-bottom: 0.35rem;">Session Quota Cap</div>
        <div style="font-size: 0.85rem; color: var(--text-secondary);">Max 30 self-created sandbox records per resource per identity.</div>
      </div>
      <div style="background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem;">
        <div style="font-weight: 700; font-size: 0.95rem; color: var(--text-primary); margin-bottom: 0.35rem;">Inactivity TTL</div>
        <div style="font-size: 0.85rem; color: var(--text-secondary);">Mutations persist for up to 10 days of inactivity before automatic cleanup.</div>
      </div>
      <div style="background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem;">
        <div style="font-weight: 700; font-size: 0.95rem; color: var(--text-primary); margin-bottom: 0.35rem;">System Health</div>
        <div style="font-size: 0.85rem; color: var(--text-secondary);"><a href="/health" target="_blank" style="color: var(--primary-accent);">GET /health</a> returns real-time DB latency ms & active session counts.</div>
      </div>
    </div>
  </div>
</div>

<script>
  // Simple Portal Tab Switching Script
  document.addEventListener('DOMContentLoaded', () => {
    const tabBtns = document.querySelectorAll('.portal-tab-btn');
    const tabContents = document.querySelectorAll('.portal-tab-content');

    function switchTab(targetTab) {
      tabBtns.forEach(btn => {
        if (btn.dataset.tab === targetTab) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      tabContents.forEach(content => {
        if (content.id === `portal-tab-${targetTab}`) {
          content.style.display = 'block';
        } else {
          content.style.display = 'none';
        }
      });
    }

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        switchTab(btn.dataset.tab);
      });
    });

    // Interactive API Studio Execution Handler
    const sendBtn = document.getElementById('studio-send-btn');
    const methodSelect = document.getElementById('studio-method-select');
    const urlInput = document.getElementById('studio-url-input');
    const delaySelect = document.getElementById('studio-delay-select');
    const statusSelect = document.getElementById('studio-status-select');
    const bodyInput = document.getElementById('studio-body-input');
    const bodyContainer = document.getElementById('studio-body-container');
    const resOutput = document.getElementById('studio-response-output');
    const statusBadge = document.getElementById('studio-res-status-badge');
    const timeBadge = document.getElementById('studio-res-time-badge');

    if (methodSelect && bodyContainer) {
      methodSelect.addEventListener('change', () => {
        const val = methodSelect.value;
        if (val === 'POST' || val === 'PUT' || val === 'PATCH') {
          bodyContainer.style.display = 'block';
          if (!bodyInput.value) {
            bodyInput.value = JSON.stringify({ title: 'Sample Title', body: 'Sample Content', userId: 1 }, null, 2);
          }
        } else {
          bodyContainer.style.display = 'none';
        }
      });
    }

    if (sendBtn) {
      sendBtn.addEventListener('click', async () => {
        const method = methodSelect.value;
        let url = urlInput.value.trim();
        if (!url.startsWith('http') && !url.startsWith('/')) {
          url = '/' + url;
        }

        const delay = delaySelect.value;
        const status = statusSelect.value;

        // Append query params if selected
        if (delay !== '0' && !url.includes('_delay=')) {
          url += (url.includes('?') ? '&' : '?') + `_delay=${delay}`;
        }
        if (status !== '200' && !url.includes('_status=')) {
          url += (url.includes('?') ? '&' : '?') + `_status=${status}`;
        }

        statusBadge.textContent = 'Status: Sending...';
        statusBadge.style.color = '#eab308';
        resOutput.innerHTML = '<code>Executing request...</code>';

        const startTime = Date.now();
        try {
          const fetchOpts = {
            method,
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include'
          };
          if ((method === 'POST' || method === 'PUT' || method === 'PATCH') && bodyInput.value) {
            fetchOpts.body = bodyInput.value;
          }

          const res = await fetch(url, fetchOpts);
          const duration = Date.now() - startTime;
          timeBadge.textContent = `${duration} ms`;

          statusBadge.textContent = `Status: ${res.status} ${res.statusText}`;
          if (res.ok) {
            statusBadge.style.color = '#22c55e';
          } else {
            statusBadge.style.color = '#ef4444';
          }

          const json = await res.json();
          resOutput.innerHTML = `<code>${JSON.stringify(json, null, 2)}</code>`;
        } catch (err) {
          const duration = Date.now() - startTime;
          timeBadge.textContent = `${duration} ms`;
          statusBadge.textContent = 'Status: Error';
          statusBadge.style.color = '#ef4444';
          resOutput.innerHTML = `<code>Error: ${err.message}</code>`;
        }
      });
    }

    const studioCopyJsonBtn = document.getElementById('studio-copy-json-btn');
    if (studioCopyJsonBtn && resOutput) {
      studioCopyJsonBtn.addEventListener('click', () => {
        const text = resOutput.textContent || resOutput.innerText;
        if (text && !text.includes('Click "Send Request"')) {
          if (typeof window.copyTextToClipboard === 'function') {
            window.copyTextToClipboard(text.trim(), '📄 Response JSON copied to clipboard!');
          } else if (navigator.clipboard) {
            navigator.clipboard.writeText(text.trim());
          }
        }
      });
    }

    const copyTsBtn = document.getElementById('copy-ts-types-btn');
    const tsBlock = document.getElementById('ts-types-code-block');

    if (tsBlock) {
      fetch('/types/ts')
        .then(res => res.text())
        .then(text => {
          if (text) tsBlock.textContent = text;
        })
        .catch(err => console.warn('[TypeScript] Failed to fetch /types/ts:', err));
    }

    if (copyTsBtn) {
      copyTsBtn.addEventListener('click', () => {
        fetch('/types/ts')
          .then(res => res.text())
          .then(text => {
            if (typeof window.copyTextToClipboard === 'function') {
              window.copyTextToClipboard(text, '📘 TypeScript definitions copied to clipboard!');
            } else if (navigator.clipboard) {
              navigator.clipboard.writeText(text);
            }
          });
      });
    }

    const portalExportSelect = document.getElementById('portal-export-resource-select');
    if (portalExportSelect) {
      portalExportSelect.addEventListener('change', () => {
        const val = portalExportSelect.value;
        const q = (val && val !== 'all') ? `?resource=${val}` : '';
        const openapiBtn = document.getElementById('portal-export-openapi');
        const postmanBtn = document.getElementById('portal-export-postman');
        const brunoBtn = document.getElementById('portal-export-bruno');
        const insomniaBtn = document.getElementById('portal-export-insomnia');

        if (openapiBtn) openapiBtn.href = `/downloads/openapi.json${q}`;
        if (postmanBtn) postmanBtn.href = `/downloads/postman.json${q}`;
        if (brunoBtn) brunoBtn.href = `/downloads/bruno.json${q}`;
        if (insomniaBtn) insomniaBtn.href = `/downloads/insomnia.json${q}`;
      });
    }
  });
</script>
