<div class="hero">
  <h1 class="hero-title">Free Stateful Fake REST API for Prototyping & Testing</h1>
  <p class="hero-subtitle">
    Playground API is a zero-configuration, JSONPlaceholder-compatible mock REST API with instant, per-visitor session sandbox overlays. Prototype frontend applications, test HTTP clients, and execute realistic CRUD operations without breaking shared global seed data.
  </p>

  <!-- Hero Interactive Search Input -->
  <div style="margin-top: 1.5rem; max-width: 600px; margin-left: auto; margin-right: auto; position: relative;">
    <input 
      type="search" 
      id="hero-search" 
      class="sidebar-search" 
      style="padding: 0.85rem 1.25rem 0.85rem 2.5rem; font-size: 1rem; border-radius: 10px; background-color: var(--bg-card); box-shadow: 0 4px 14px rgba(0,0,0,0.15);"
      placeholder="🔍 Search endpoints (e.g. 'get single user', 'create post', 'delete')..."
    />
  </div>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="example-box" style="margin-bottom: 1.5rem; border-color: var(--delete-badge);">
    <h4 style="color: var(--delete-badge);"><%= error %></h4>
  </div>
<% } %>

<% if (typeof info !== 'undefined' && info) { %>
  <div class="example-box" style="margin-bottom: 1.5rem; border-color: var(--primary-accent);">
    <h4 style="color: var(--primary-accent);"><%= info %></h4>
  </div>
<% } %>

<!-- Root Search Results Section (Shown when search query is active) -->
<section id="root-search-container" hidden style="margin-bottom: 2.5rem;">
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
    <h2 style="font-size: 1.4rem; color: var(--text-primary);" id="root-search-heading">Search Results</h2>
    <button type="button" class="btn btn-secondary clear-search-btn" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;">Clear Search Filter</button>
  </div>
  <div id="root-search-results-list" class="endpoints-list"></div>
</section>

<!-- Overview Content Container (Hidden when search query is active) -->
<div id="root-overview-content">
  <!-- Architecture Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 2.5rem;">
    <div class="endpoint-card" style="margin: 0;">
      <div style="font-weight: 700; font-size: 1.1rem; color: var(--get-badge); margin-bottom: 0.5rem;">
        🔄 Virtual Merging Engine
      </div>
      <p style="font-size: 0.9rem; color: var(--text-secondary);">
        <code>GET</code> requests dynamically construct a virtual list merging global database records with your session's creates (on top), updates (in-place), and deletes.
      </p>
    </div>

    <div class="endpoint-card" style="margin: 0;">
      <div style="font-weight: 700; font-size: 1.1rem; color: var(--post-badge); margin-bottom: 0.5rem;">
        🛡️ 30-Record Quota Cap
      </div>
      <p style="font-size: 0.9rem; color: var(--text-secondary);">
        Each identity session is allowed up to 30 self-created sandbox records per resource. Local sandbox records receive <code>local-&lt;uuid&gt;</code> string IDs.
      </p>
    </div>

    <div class="endpoint-card" style="margin: 0;">
      <div style="font-weight: 700; font-size: 1.1rem; color: var(--put-badge); margin-bottom: 0.5rem;">
        🔒 Cookie & Header Session Token
      </div>
      <p style="font-size: 0.9rem; color: var(--text-secondary);">
        Identity is securely resolved via <code>pg_identity</code> HTTP cookie or <code>X-Playground-Identity</code> header with HMAC-SHA256 token validation.
      </p>
    </div>

    <div class="endpoint-card" style="margin: 0;">
      <div style="font-weight: 700; font-size: 1.1rem; color: var(--patch-badge); margin-bottom: 0.5rem;">
        ⏱️ Network Delay & Error Simulation
      </div>
      <p style="font-size: 0.9rem; color: var(--text-secondary);">
        Simulate artificial latency (<code>?_delay=1500</code>) or force HTTP error codes (<code>?_status=500</code>) to test frontend error handling & loading UI states.
      </p>
    </div>

    <div class="endpoint-card" style="margin: 0;">
      <div style="font-weight: 700; font-size: 1.1rem; color: #38bdf8; margin-bottom: 0.5rem;">
        📦 Multi-Format Collection Exports
      </div>
      <p style="font-size: 0.9rem; color: var(--text-secondary);">
        Instantly export OpenAPI 3.0 Specs, Postman v2.1 Collections, Bruno, and Insomnia files for all or individual API resources.
      </p>
    </div>

    <div class="endpoint-card" style="margin: 0; border-color: rgba(168, 85, 247, 0.4); background: rgba(168, 85, 247, 0.03);">
      <div style="font-weight: 700; font-size: 1.1rem; color: #c084fc; margin-bottom: 0.5rem;">
        ⚡ GraphQL Sandbox Gateway
      </div>
      <p style="font-size: 0.9rem; color: var(--text-secondary);">
        Execute stateful GraphQL queries, mutations, and Apollo/Relay integrations with embedded GraphiQL IDE at <code>/graphql</code>.
      </p>
    </div>

    <div class="endpoint-card" style="margin: 0; cursor: pointer; border-color: rgba(16, 185, 129, 0.4); background: rgba(16, 185, 129, 0.03);" id="overview-explainer-trigger-card" onclick="document.getElementById('open-explainer-modal-btn') && document.getElementById('open-explainer-modal-btn').click()">
      <div style="font-weight: 700; font-size: 1.1rem; color: var(--primary-accent); margin-bottom: 0.5rem;">
        💡 How Sandboxing Works
      </div>
      <p style="font-size: 0.9rem; color: var(--text-secondary);">
        Click to explore how zero-login stateful sandboxing works without breaking shared global seed data for other developers.
      </p>
    </div>
  </div>

