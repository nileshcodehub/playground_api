PORT=3000

# 1. Local PostgreSQL (No SSL required):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/playground_api?schema=public"

# 2. Neon Cloud PostgreSQL (SSL IS REQUIRED when connecting to Neon from localhost or production):
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_NEON_HOST/YOUR_DB_NAME?sslmode=require"

# Generate a strong random salt: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT="replace_with_a_strong_random_secret"
TRUST_PROXY=false
NODE_ENV=development